{
  "name": "erp-sales",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "init": "bun run --cwd apps/server prisma generate",
    "prod": "bun run --cwd apps/server prisma generate && turbo run build && pm2 start ecosystem.config.js",
    "restart-prod": "pm2 restart ecosystem.config.js",
    "prod:stop": "pm2 stop ecosystem.config.js",
    "prod:logs": "pm2 logs",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "tsc": "cd apps/server && tsc --noEmit && cd ../client && tsc --noEmit && cd ../../packages/schemas && tsc --noEmit"
  },
  "devDependencies": {
    "@trpc/server": "^11.17.0",
    "concurrently": "^9.1.2",
    "pm2": "^5.4.3",
    "prettier": "^3.9.6",
    "shadcn": "^4.14.0",
    "turbo": "^2.10.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-check": "^4.8.0",
    "lucide-react": "^1.25.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  }
}
