{
  "name": "erp-sales",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "init": "bun run --cwd apps/server prisma generate",
    "prod": "bun run --cwd apps/server prisma generate && pm2 start ecosystem.config.js",
    "prod:restart": "pm2 restart ecosystem.config.js",
    "prod:stop": "pm2 stop ecosystem.config.js",
    "prod:logs": "pm2 logs",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@trpc/server": "^11.18.0",
    "concurrently": "^10.0.4",
    "prettier": "^3.9.6",
    "turbo": "^2.11.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  },
  "dependencies": {}
}
