// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/marcosgomesneto/bun-devcontainers/tree/main/src/basic-bun
{
  "name": "erp_sales",
  "dockerFile": "Dockerfile",
  "forwardPorts": [10021, 10022],
  // Install deps automatically so reviewers can run the app immediately on open.
  "postCreateCommand": "bun install",
  "containerEnv": {
    "HOST": "0.0.0.0",
    "NODE_ENV": "production",
    "VITE_TRPC_URL": "https://erp-sales-api.aetherglo.com"
  },
  "portsAttributes": {
    "10021": {
      "label": "Vite Client",
      "onAutoForward": "notify"
    },
    "10022": {
      "label": "tRPC Server",
      "onAutoForward": "notify"
    }
  },
  // Self-contained Postgres (trust auth, internal only) so the app is runnable for
  // reviewers without external setup. DB port is intentionally NOT forwarded publicly.
  "services": {
    "postgres": {
      "image": "postgres:16-alpine",
      "environment": {
        "POSTGRES_USER": "erp",
        "POSTGRES_DB": "erp_sales",
        "POSTGRES_HOST_AUTH_METHOD": "trust"
      },
      "volumes": ["postgres-data:/var/lib/postgresql/data"],
      "restart": "unless-stopped"
    }
  },
  // Configure tool-specific properties.
  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      // Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        "oven.bun-vscode",
        "Prisma.prisma",
        "bradlc.vscode-tailwindcorConfig",
        "dbaeumer.vscode-eslint",
        "sst-dev.opencode"
      ]
    }
  }
}
