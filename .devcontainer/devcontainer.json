// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/marcosgomesneto/bun-devcontainers/tree/main/src/basic-bun
{
  "name": "erp_sales",
  "dockerFile": "Dockerfile",
  // Forward dev server ports from container → VPS → your local machine.
  // After rebuild, access at http://localhost:10021 (frontend) and http://localhost:10022 (API).
  "runArgs": ["--network=dev", "--name=erp_sales"],
  "forwardPorts": [10021, 10022],
  "appPort": ["10021:10021", "10022:10022"],
  "containerEnv": {
    "HOST": "0.0.0.0",
    "NODE_ENV": "production",
    "VITE_TRPC_URL": "https://erp-sales-api.aetherglo.com",
    "COPILOT_PROVIDER_BASE_URL": "https://inference.poolside.ai/v1/chat/completions",
    "COPILOT_PROVIDER_API_KEY": "sky_UXu9nseA.vrrzsPz3YTTenRiNYeWXf4sGCozzSaLy",
    "COPILOT_wMODEL": "poolside/laguna-s-2.1",
    "COPILOT_PROVIDER_MAX_PROMPT_TOKENS": "256000",
    "COPILOT_PROVIDER_MAX_OUTPUT_TOKENS": "32768"
  },
  "portsAttributes": {
    "10021": {
      "label": "Vite Client",
      "onAutoForward": "notify"
    },
    "10022": {
      "label": "tRPC Server",
      "onAutoForward": "notify"
    }
  },
  // Configure tool-specific properties.
  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      // Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        "oven.bun-vscode",
        "Prisma.prisma",
        "bradlc.vscode-tailwindcorConfig",
        "dbaeumer.vscode-eslint",
        "sst-dev.opencode"
      ]
    }
  },
  // Install deps + generate Prisma client after the workspace is mounted.
  // The Dockerfile can't do this at build time because package.json isn't present until runtime.
  "postCreateCommand": "bun install && bun run init"
}