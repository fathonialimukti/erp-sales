{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "webfetch": "allow",
    "websearch": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "prisma": {
      "type": "remote",
      "url": "https://mcp.prisma.io/mcp",
      "enabled": true
    },
    "css_first": {
      "type": "remote",
      "url": "https://mcp-css-first.chylik-lukas.workers.dev/sse",
      "enabled": false
    },
    "prisma_local": {
      "type": "local",
      "command": ["bunx", "prisma", "mcp"],
      "cwd": "apps/server",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["bunx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "chrome_devtools": {
      "type": "local",
      "command": ["bunx", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["bunx", "shadcn@latest", "mcp"],
      "enabled": true
    }
  },
  "model": "routers9/longcat-2.0",
  "small_model": "routers9/deepseek/deepseek-v4-flash-0731",
  "provider": {
    "routers9": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Routers9",
      "options": {
        "baseURL": "https://routers9.web.id/v1",
        "apiKey": "{env:ROUTERS9_API_KEY}"
      },
      "blacklist": [
        "poolside/laguna-xs-2.1",
        "upstage/solar-pro4",
        "inclusionai/ling-3.0-flash-fin",
        "inclusionai/ling-3.0-flash-sante",
        "mimo-v2.6-flash-new",
        "muse-spark-1.3-contributor-xhigh",
        "stealth/space-bunny-alpha"
      ],
      "models": {
        "atria-dawn-preview": {
          "id": "routers9/atria-dawn-preview",
          "name": "Atria Dawn Preview",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "deepseek/deepseek-v4-flash-0731": {
          "id": "routers9/deepseek/deepseek-v4-flash-0731",
          "name": "DeepSeek V4 Flash 0731 (MAX)",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "longcat-2.0": {
          "id": "routers9/longcat-2.0",
          "name": "LongCat 2.0",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "output": 262144
          }
        },
        "poolside/laguna-s-2.1": {
          "id": "routers9/poolside/laguna-s-2.1",
          "name": "Laguna S 2.1",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        }
      }
    }
  }
}
