{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "prisma": {
      "type": "remote",
      "url": "https://mcp.prisma.io/mcp",
      "enabled": true
    },
    "css_first": {
      "type": "remote",
      "url": "https://mcp-css-first.chylik-lukas.workers.dev/sse",
      "enabled": false
    },
    "prisma_local": {
      "type": "local",
      "command": ["bunx", "prisma", "mcp"],
      "cwd": "apps/server",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["bunx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "chrome_devtools": {
      "type": "local",
      "command": ["bunx", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["bunx", "shadcn@latest", "mcp"],
      "enabled": true
    }
  }
}
