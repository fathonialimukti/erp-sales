generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// =============================================
// MAIN MODELS
// =============================================

model User {
  id       String  @id @default(ulid()) @map("id")
  email    String  @unique @map("email")
  name     String? @map("name")
  password String  @map("password")
  roleId   String? @map("role_id")
  photo    String? @map("photo")
  areaId   String? @map("area_id")
  crmArea  Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  role     Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull, onUpdate: Cascade)

 

  notificationsReceived Notification[] @relation("notification_recipient")
  notificationsCreated  Notification[] @relation("notification_created_by")
  activityLogs          ActivityLog[]

  // CRM relations
  visitLogs            VisitLog[]
  approvedVisits       VisitLog[]        @relation("visit_approved_by")
  createdSalesOrders   SalesOrder[]      @relation("so_created_by")
  approvedSalesOrders  SalesOrder[]      @relation("so_approved_by")
  picActionPrograms    ActionProgram[]   @relation("action_program_pic")
  createdActionPrograms ActionProgram[]  @relation("ap_created_by")
  createdEventProposals EventProposal[]  @relation("ep_created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([roleId])
  @@map("users")
}

model Role {
  id          String              @id @default(ulid()) @map("id")
  name        String              @unique @map("name")
  description String?             @map("description")
  users       User[]
  permissions RoleHasPermission[]
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String              @id @default(ulid()) @map("id")
  name        String              @unique @map("name")
  description String?             @map("description")
  roles       RoleHasPermission[]
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@map("permissions")
}

model RoleHasPermission {
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  roleId       String     @map("role_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@id([roleId, permissionId])
  @@map("role_has_permissions")
}

// =============================================
// ENUMS
// =============================================

enum ApprovalStatus {
  DRAFT
  PROPOSED
  APPROVED
  REJECTED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationTargetType {
  SYSTEM
  SALES_ORDER
  INVOICE
  PAYMENT
  ACTION_PROGRAM
  EVENT_PROPOSAL
  VISIT_LOG
  CUSTOMER
  OUTLET
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

// =============================================
// PRODUCT CATALOG
// =============================================

model SkuCategory {
  id          String   @id @default(ulid()) @map("id")
  code        String?  @unique @map("code")
  name        String   @map("name")
  description String?  @map("description")
  skus        Sku[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sku_categories")
}

model Sku {
  id            String       @id @default(ulid()) @map("id")
  code          String?      @unique @map("code")
  name          String       @map("name")
  description   String?      @map("description")
  photo         String?      @map("photo")
  categoryId    String?      @map("category_id")
  category      SkuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  basePrice     Decimal?     @map("base_price")
  baseUnit      String       @default("pcs") @map("base_unit")
  status        String       @default("ACTIVE") @map("status")

  salesOrderItems       SalesOrderItem[]
  actionProgramSkus     ActionProgramSku[]
  eventProposalSkus     EventProposalSku[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@map("skus")
}


// =============================================
// NOTIFICATION & ACTIVITY LOG
// =============================================

model Notification {
  id          String                 @id @default(ulid()) @map("id")
  userId      String                 @map("user_id")
  user        User                   @relation("notification_recipient", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdById String?                @map("created_by_id")
  createdBy   User?                  @relation("notification_created_by", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  title       String                 @map("title")
  message     String                 @map("message")
  type        NotificationType       @default(INFO) @map("type")
  targetType  NotificationTargetType @default(SYSTEM) @map("target_type")
  targetId    String?                @map("target_id")
  actionUrl   String?                @map("action_url")
  metadata    Json?                  @map("metadata")
  isRead      Boolean                @default(false) @map("is_read")
  readAt      DateTime?              @map("read_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  @@index([userId, isRead])
  @@index([targetType, targetId])
  @@index([createdById])
  @@map("notifications")
}

model ActivityLog {
  id         String         @id @default(ulid()) @map("id")
  action     ActivityAction @map("action")
  userId     String         @map("user_id")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource   String         @map("resource")
  resourceId String         @map("resource_id")
  message    String         @map("message")
  detail     Json?          @map("detail")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([resource, resourceId, action])
  @@index([action, createdAt])
  @@map("activity_logs")
}

// =============================================
// CRM MODELS
// =============================================

model Region {
  id        String   @id @default(ulid()) @map("id")
  code      String?  @unique @map("code")
  name      String   @map("name")
  areas     Area[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("crm_regions")
}

model Area {
  id                String              @id @default(ulid()) @map("id")
  regionId          String              @map("region_id")
  region            Region              @relation(fields: [regionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  code              String?             @unique @map("code")
  name              String              @map("name")
  salesmen          User[]
  outlets           Outlet[]
  actionPrograms    ActionProgram[]
  eventProposals    EventProposal[]
  salesOrders       SalesOrder[]
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([regionId])
  @@map("crm_areas")
}

model Customer {
  id             String              @id @default(ulid()) @map("id")
  code           String?             @unique @map("code")
  name           String              @map("name")
  taxId          String?             @map("tax_id")
  paymentTerms   String?             @map("payment_terms")
  creditLimit    Decimal?            @map("credit_limit")
  status         String              @default("ACTIVE") @map("status")
  billingAddress String?             @map("billing_address")
  notes          String?             @map("notes")
  outlets        Outlet[]
  contacts       CustomerContact[]
  salesOrders    SalesOrder[]
  invoices       Invoice[]
  payments       Payment[]
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@map("crm_customers")
}

model CustomerContact {
  id         String    @id @default(ulid()) @map("id")
  customerId String    @map("customer_id")
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  outletId   String?   @map("outlet_id")
  outlet     Outlet?   @relation(fields: [outletId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  name       String    @map("name")
  title      String?   @map("title")
  email      String?   @map("email")
  phone      String?   @map("phone")
  isPrimary  Boolean   @default(false) @map("is_primary")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([outletId])
  @@map("crm_customer_contacts")
}

model Outlet {
  id           String     @id @default(ulid()) @map("id")
  customerId   String     @map("customer_id")
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  areaId       String     @map("area_id")
  area         Area       @relation(fields: [areaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  code         String?    @unique @map("code")
  name         String     @map("name")
  address      String?    @map("address")
  contactName  String?    @map("contact_name")
  contactPhone String?    @map("contact_phone")
  latitude     Float?     @map("latitude")
  longitude    Float?     @map("longitude")
  status       String     @default("ACTIVE") @map("status")
  contacts     CustomerContact[]
  visitLogs    VisitLog[]
  salesOrders  SalesOrder[]
  actionProgramOutlets ActionProgramOutlet[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([areaId])
  @@map("crm_outlets")
}

model VisitLog {
  id             String         @id @default(ulid()) @map("id")
  salesmanId     String         @map("salesman_id")
  salesman       User           @relation(fields: [salesmanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  outletId       String         @map("outlet_id")
  outlet         Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  date           DateTime       @map("date") @db.Date
  checkInAt      DateTime?      @map("check_in_at")
  checkOutAt     DateTime?      @map("check_out_at")
  purpose        String?        @map("purpose")
  notes          String?        @map("notes")
  photos         Json?          @map("photos")
  feedback       String?        @map("feedback")
  salesOrderId   String?        @map("sales_order_id")
  salesOrder     SalesOrder?    @relation(fields: [salesOrderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  approvalStatus ApprovalStatus @default(DRAFT) @map("approval_status")
  submittedAt    DateTime?      @map("submitted_at")
  approvedById   String?        @map("approved_by_id")
  approvedBy     User?          @relation("visit_approved_by", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedAt     DateTime?      @map("approved_at")

  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([salesmanId, date])
  @@index([outletId, date])
  @@index([approvalStatus])
  @@map("crm_visit_logs")
}

model SalesOrder {
  id                    String         @id @default(ulid()) @map("id")
  documentNumber        String?        @unique @map("document_number")
  date                  DateTime       @default(now()) @map("date") @db.Date
  customerId            String         @map("customer_id")
  customer              Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  outletId              String?        @map("outlet_id")
  outlet                Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  areaId                String         @map("area_id")
  area                  Area           @relation(fields: [areaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currency              String         @default("IDR") @map("currency")
  paymentTerms          String?        @map("payment_terms")
  expectedDeliveryDate  DateTime?      @map("expected_delivery_date") @db.Date
  notes                 String?        @map("notes")
  source                String         @default("MANUAL") @map("source")

  approvalStatus        ApprovalStatus @default(DRAFT) @map("approval_status")
  createdById           String         @map("created_by_id")
  createdBy             User           @relation("so_created_by", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  proposedAt            DateTime?      @map("proposed_at")
  approvedById          String?        @map("approved_by_id")
  approvedBy            User?          @relation("so_approved_by", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedAt            DateTime?      @map("approved_at")
  approvalHistory       Json?          @map("approval_history")

  items                 SalesOrderItem[]
  visitLogs             VisitLog[]
  invoices              Invoice[]

  subtotal              Decimal?       @map("subtotal")
  discountTotal         Decimal?       @map("discount_total")
  taxTotal              Decimal?       @map("tax_total")
  grandTotal            Decimal?       @map("grand_total")

  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([outletId])
  @@index([areaId])
  @@index([createdById])
  @@index([approvedById])
  @@index([approvalStatus])
  @@index([documentNumber])
  @@index([date])
  @@index([approvalStatus, date])
  @@map("crm_sales_orders")
}

model SalesOrderItem {
  id              String     @id @default(ulid()) @map("id")
  sortOrder       Int?       @default(0) @map("sort_order")
  salesOrderId    String     @map("sales_order_id")
  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  skuId           String     @map("sku_id")
  sku             Sku        @relation(fields: [skuId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quantity        Decimal    @map("quantity")
  unitPrice       Decimal    @map("unit_price")
  discountPercent Decimal?   @default(0) @map("discount_percent")
  taxPercent      Decimal?   @default(0) @map("tax_percent")
  lineTotal       Decimal    @map("line_total")
  notes           String?    @map("notes")

  @@index([salesOrderId])
  @@index([skuId])
  @@map("crm_sales_order_items")
}

model Invoice {
  id             String    @id @default(ulid()) @map("id")
  documentNumber String?   @unique @map("document_number")
  salesOrderId   String    @map("sales_order_id")
  salesOrder     SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customerId     String    @map("customer_id")
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  date           DateTime  @default(now()) @map("date") @db.Date
  dueDate        DateTime  @map("due_date") @db.Date
  status         String    @default("DRAFT") @map("status")
  currency       String    @default("IDR") @map("currency")
  subtotal       Decimal   @map("subtotal")
  taxTotal       Decimal   @map("tax_total")
  grandTotal     Decimal   @map("grand_total")
  balanceDue     Decimal   @map("balance_due")
  notes          String?   @map("notes")
  payments       Payment[]
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([salesOrderId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("crm_invoices")
}

model Payment {
  id          String   @id @default(ulid()) @map("id")
  invoiceId   String   @map("invoice_id")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customerId  String   @map("customer_id")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  date        DateTime @default(now()) @map("date") @db.Date
  amount      Decimal  @map("amount")
  method      String?  @map("method")
  reference   String?  @map("reference")
  notes       String?  @map("notes")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([customerId])
  @@map("crm_payments")
}

enum ActionProgramType {
  DISCOUNT
  BUNDLE
  FREE_ITEM
  REBATE
  LOYALTY
}

model ActionProgram {
  id                         String            @id @default(ulid()) @map("id")
  documentNumber             String?           @unique @map("document_number")
  name                       String            @map("name")
  type                       ActionProgramType @map("type")
  description                String?           @map("description")
  files                      Json?             @map("files")
  startDate                  DateTime          @map("start_date") @db.Date
  endDate                    DateTime          @map("end_date") @db.Date
  budgetAmount               Decimal?          @map("budget_amount")
  budgetCurrency             String            @default("IDR") @map("budget_currency")
  rules                      Json              @map("rules")
  areaId                     String            @map("area_id")
  area                       Area              @relation(fields: [areaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  picId                      String            @map("pic_id")
  pic                        User              @relation("action_program_pic", fields: [picId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  approvalStatus             ApprovalStatus    @default(DRAFT) @map("approval_status")
  createdById                String            @map("created_by_id")
  createdBy                  User              @relation("ap_created_by", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  areaManagerApprovedById    String?           @map("area_manager_approved_by_id")
  areaManagerApprovedAt      DateTime?         @map("area_manager_approved_at")
  regionManagerApprovedById  String?           @map("region_manager_approved_by_id")
  regionManagerApprovedAt    DateTime?         @map("region_manager_approved_at")
  financeManagerApprovedById String?           @map("finance_manager_approved_by_id")
  financeManagerApprovedAt   DateTime?         @map("finance_manager_approved_at")
  directorApprovedById       String?           @map("director_approved_by_id")
  directorApprovedAt         DateTime?         @map("director_approved_at")
  approvalHistory            Json?             @map("approval_history")

  outlets                    ActionProgramOutlet[]
  skus                       ActionProgramSku[]
  payments                   ActionProgramPayment[]

  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")

  @@index([areaId])
  @@index([picId])
  @@index([createdById])
  @@index([approvalStatus])
  @@index([startDate, endDate])
  @@map("crm_action_programs")
}

model ActionProgramOutlet {
  actionProgramId String        @map("action_program_id")
  actionProgram   ActionProgram @relation(fields: [actionProgramId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  outletId        String        @map("outlet_id")
  outlet          Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([actionProgramId, outletId])
  @@map("crm_action_program_outlets")
}

model ActionProgramSku {
  actionProgramId String        @map("action_program_id")
  actionProgram   ActionProgram @relation(fields: [actionProgramId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  skuId           String        @map("sku_id")
  sku             Sku           @relation(fields: [skuId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([actionProgramId, skuId])
  @@map("crm_action_program_skus")
}

model ActionProgramPayment {
  id              String        @id @default(ulid()) @map("id")
  actionProgramId String        @map("action_program_id")
  actionProgram   ActionProgram @relation(fields: [actionProgramId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  amount          Decimal       @map("amount")
  paymentDate     DateTime      @map("payment_date") @db.Date
  method          String?       @map("method")
  reference       String?       @map("reference")
  notes           String?       @map("notes")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([actionProgramId])
  @@map("crm_action_program_payments")
}

model EventProposal {
  id                         String         @id @default(ulid()) @map("id")
  documentNumber             String?        @unique @map("document_number")
  name                       String         @map("name")
  eventType                  String?        @map("event_type")
  description                String?        @map("description")
  files                      Json?          @map("files")
  venue                      String?        @map("venue")
  eventDate                  DateTime       @map("event_date") @db.Date
  eventEndDate               DateTime?      @map("event_end_date") @db.Date
  organizerName              String?        @map("organizer_name")
  organizerContact           String?        @map("organizer_contact")
  areaId                     String         @map("area_id")
  area                       Area           @relation(fields: [areaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  observationDays            Int            @default(90) @map("observation_days")
  proposedBudget             Decimal?       @map("proposed_budget")
  currency                   String         @default("IDR") @map("currency")

  approvalStatus             ApprovalStatus @default(DRAFT) @map("approval_status")
  createdById                String         @map("created_by_id")
  createdBy                  User           @relation("ep_created_by", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  areaManagerApprovedById    String?        @map("area_manager_approved_by_id")
  areaManagerApprovedAt      DateTime?      @map("area_manager_approved_at")
  regionManagerApprovedById  String?        @map("region_manager_approved_by_id")
  regionManagerApprovedAt    DateTime?      @map("region_manager_approved_at")
  financeManagerApprovedById String?        @map("finance_manager_approved_by_id")
  financeManagerApprovedAt   DateTime?      @map("finance_manager_approved_at")
  directorApprovedById       String?        @map("director_approved_by_id")
  directorApprovedAt         DateTime?      @map("director_approved_at")
  approvalHistory            Json?          @map("approval_history")

  skus                       EventProposalSku[]
  payments                   EventProposalPayment[]

  createdAt                  DateTime       @default(now()) @map("created_at")
  updatedAt                  DateTime       @updatedAt @map("updated_at")

  @@index([areaId])
  @@index([createdById])
  @@index([approvalStatus])
  @@index([eventDate])
  @@map("crm_event_proposals")
}

model EventProposalSku {
  eventProposalId String        @map("event_proposal_id")
  eventProposal   EventProposal @relation(fields: [eventProposalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  skuId           String        @map("sku_id")
  sku             Sku           @relation(fields: [skuId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([eventProposalId, skuId])
  @@map("crm_event_proposal_skus")
}

model EventProposalPayment {
  id              String        @id @default(ulid()) @map("id")
  eventProposalId String        @map("event_proposal_id")
  eventProposal   EventProposal @relation(fields: [eventProposalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  amount          Decimal       @map("amount")
  paymentDate     DateTime      @map("payment_date") @db.Date
  method          String?       @map("method")
  reference       String?       @map("reference")
  notes           String?       @map("notes")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([eventProposalId])
  @@map("crm_event_proposal_payments")
}

model KnowledgeChunk {
  id        String   @id @default(ulid()) @map("id")
  source    String   @map("source")
  title     String   @map("title")
  content   String   @map("content")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([source])
  @@map("knowledge_chunks")
}
