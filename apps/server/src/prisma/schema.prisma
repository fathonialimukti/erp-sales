generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String          @id @default(ulid()) @map("id")
  email                 String          @unique @map("email")
  name                  String?         @map("name")
  description           String?         @map("description")
  password              String          @map("password")
  roleId                String?         @map("role_id")
  photo                 String?         @map("photo")
  areaId                String?         @map("area_id")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  activityLogs          ActivityLog[]
  createdActionPrograms ActionProgram[] @relation("ap_created_by")
  picActionPrograms     ActionProgram[] @relation("action_program_pic")
  createdEventProposals EventProposal[] @relation("ep_created_by")
  approvedSalesOrders   SalesOrder[]    @relation("so_approved_by")
  createdSalesOrders    SalesOrder[]    @relation("so_created_by")
  approvedVisits        VisitLog[]      @relation("visit_approved_by")
  visitLogs             VisitLog[]
  notificationsCreated  Notification[]  @relation("notification_created_by")
  notificationsReceived Notification[]  @relation("notification_recipient")
  crmArea               Area?           @relation(fields: [areaId], references: [id])
  role                  Role?           @relation(fields: [roleId], references: [id])
  backups               Backup[]        @relation("backup_created_by")

  @@index([roleId])
  @@map("users")
}

model Role {
  id          String              @id @default(ulid()) @map("id")
  name        String              @unique @map("name")
  description String?             @map("description")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  permissions RoleHasPermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String              @id @default(ulid()) @map("id")
  name        String              @unique @map("name")
  description String?             @map("description")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  roles       RoleHasPermission[]

  @@map("permissions")
}

model RoleHasPermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_has_permissions")
}

model SkuCategory {
  id          String   @id @default(ulid()) @map("id")
  code        String?  @unique @map("code")
  name        String   @map("name")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  skus        Sku[]

  @@map("sku_categories")
}

model Sku {
  id                String             @id @default(ulid()) @map("id")
  code              String?            @unique @map("code")
  name              String             @map("name")
  description       String?            @map("description")
  photo             String?            @map("photo")
  categoryId        String?            @map("category_id")
  basePrice         Decimal?           @map("base_price")
  baseUnit          String             @default("pcs") @map("base_unit")
  status            String             @default("ACTIVE") @map("status")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  actionProgramSkus ActionProgramSku[]
  eventProposalSkus EventProposalSku[]
  salesOrderItems   SalesOrderItem[]
  category          SkuCategory?       @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("skus")
}

model Notification {
  id          String                 @id @default(ulid()) @map("id")
  userId      String                 @map("user_id")
  createdById String?                @map("created_by_id")
  title       String                 @map("title")
  message     String                 @map("message")
  type        NotificationType       @default(INFO) @map("type")
  targetType  NotificationTargetType @default(SYSTEM) @map("target_type")
  targetId    String?                @map("target_id")
  actionUrl   String?                @map("action_url")
  metadata    Json?                  @map("metadata")
  isRead      Boolean                @default(false) @map("is_read")
  readAt      DateTime?              @map("read_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  createdBy   User?                  @relation("notification_created_by", fields: [createdById], references: [id])
  user        User                   @relation("notification_recipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([targetType, targetId])
  @@index([createdById])
  @@map("notifications")
}

model ActivityLog {
  id         String         @id @default(ulid()) @map("id")
  action     ActivityAction @map("action")
  userId     String         @map("user_id")
  resource   String         @map("resource")
  resourceId String         @map("resource_id")
  message    String         @map("message")
  detail     Json?          @map("detail")
  createdAt  DateTime       @default(now()) @map("created_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([resource, resourceId, action])
  @@index([action, createdAt])
  @@map("activity_logs")
}

model Region {
  id          String       @id @default(ulid()) @map("id")
  code        String?      @unique @map("code")
  name        String       @map("name")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  budgetLines BudgetLine[]
  areas       Area[]

  @@map("crm_regions")
}

model Area {
  id             String          @id @default(ulid()) @map("id")
  regionId       String          @map("region_id")
  code           String?         @unique @map("code")
  name           String          @map("name")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  budgetLines    BudgetLine[]
  actionPrograms ActionProgram[]
  region         Region          @relation(fields: [regionId], references: [id], onDelete: Cascade)
  eventProposals EventProposal[]
  outlets        Outlet[]
  salesOrders    SalesOrder[]
  salesmen       User[]

  @@index([regionId])
  @@map("crm_areas")
}

model Customer {
  id                 String              @id @default(ulid()) @map("id")
  code               String?             @unique @map("code")
  name               String              @map("name")
  taxId              String?             @map("tax_id")
  paymentTerms       String?             @map("payment_terms")
  creditLimit        Decimal?            @map("credit_limit")
  status             String              @default("ACTIVE") @map("status")
  billingAddress     String?             @map("billing_address")
  notes              String?             @map("notes")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  contacts           CustomerContact[]
  outlets            Outlet[]
  payments           Payment[]
  salesOrders        SalesOrder[]
  emailConversations EmailConversation[]

  @@map("crm_customers")
}

model CustomerContact {
  id         String   @id @default(ulid()) @map("id")
  customerId String   @map("customer_id")
  outletId   String?  @map("outlet_id")
  name       String   @map("name")
  title      String?  @map("title")
  email      String?  @map("email")
  phone      String?  @map("phone")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  outlet     Outlet?  @relation(fields: [outletId], references: [id])

  @@index([customerId])
  @@index([outletId])
  @@map("crm_customer_contacts")
}

model Outlet {
  id                   String                @id @default(ulid()) @map("id")
  customerId           String                @map("customer_id")
  areaId               String                @map("area_id")
  code                 String?               @unique @map("code")
  name                 String                @map("name")
  address              String?               @map("address")
  contactName          String?               @map("contact_name")
  contactPhone         String?               @map("contact_phone")
  latitude             Float?                @map("latitude")
  longitude            Float?                @map("longitude")
  status               String                @default("ACTIVE") @map("status")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  actionProgramOutlets ActionProgramOutlet[]
  contacts             CustomerContact[]
  area                 Area                  @relation(fields: [areaId], references: [id])
  customer             Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesOrders          SalesOrder[]
  visitLogs            VisitLog[]

  @@index([customerId])
  @@index([areaId])
  @@map("crm_outlets")
}

model VisitLog {
  id             String         @id @default(ulid()) @map("id")
  salesmanId     String         @map("salesman_id")
  outletId       String         @map("outlet_id")
  date           DateTime       @map("date") @db.Date
  checkInAt      DateTime?      @map("check_in_at")
  checkOutAt     DateTime?      @map("check_out_at")
  purpose        String?        @map("purpose")
  notes          String?        @map("notes")
  photos         Json?          @map("photos")
  feedback       String?        @map("feedback")
  salesOrderId   String?        @map("sales_order_id")
  approvalStatus ApprovalStatus @default(DRAFT) @map("approval_status")
  submittedAt    DateTime?      @map("submitted_at")
  approvedById   String?        @map("approved_by_id")
  approvedAt     DateTime?      @map("approved_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  approvedBy     User?          @relation("visit_approved_by", fields: [approvedById], references: [id])
  outlet         Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  salesOrder     SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  salesman       User           @relation(fields: [salesmanId], references: [id], onDelete: Cascade)

  @@index([salesmanId, date])
  @@index([outletId, date])
  @@index([approvalStatus])
  @@map("crm_visit_logs")
}

model SalesOrder {
  id                   String             @id @default(ulid()) @map("id")
  documentNumber       String?            @unique @map("document_number")
  date                 DateTime           @default(now()) @map("date") @db.Date
  customerId           String?            @map("customer_id")
  outletId             String             @map("outlet_id")
  areaId               String             @map("area_id")
  currency             String             @default("IDR") @map("currency")
  paymentTerms         String?            @map("payment_terms")
  expectedDeliveryDate DateTime?          @map("expected_delivery_date") @db.Date
  notes                String?            @map("notes")
  source               String             @default("MANUAL") @map("source")
  emailConversationId  String?            @map("email_conversation_id")
  approvalStatus       ApprovalStatus     @default(DRAFT) @map("approval_status")
  createdById          String             @map("created_by_id")
  proposedAt           DateTime?          @map("proposed_at")
  approvedById         String?            @map("approved_by_id")
  approvedAt           DateTime?          @map("approved_at")
  approvalHistory      Json?              @map("approval_history")
  subtotal             Decimal?           @map("subtotal")
  discountTotal        Decimal?           @map("discount_total")
  taxTotal             Decimal?           @map("tax_total")
  grandTotal           Decimal?           @map("grand_total")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  actionProgramId      String?            @map("action_program_id")
  payments             Payment[]
  items                SalesOrderItem[]
  actionProgram        ActionProgram?     @relation(fields: [actionProgramId], references: [id])
  approvedBy           User?              @relation("so_approved_by", fields: [approvedById], references: [id])
  area                 Area               @relation(fields: [areaId], references: [id])
  createdBy            User               @relation("so_created_by", fields: [createdById], references: [id], onDelete: Cascade)
  customer             Customer?          @relation(fields: [customerId], references: [id])
  emailConversation    EmailConversation? @relation(fields: [emailConversationId], references: [id])
  outlet               Outlet             @relation(fields: [outletId], references: [id])
  visitLogs            VisitLog[]

  @@index([customerId])
  @@index([outletId])
  @@index([areaId])
  @@index([createdById])
  @@index([approvedById])
  @@index([approvalStatus])
  @@index([documentNumber])
  @@index([date])
  @@index([approvalStatus, date])
  @@index([emailConversationId])
  @@index([actionProgramId])
  @@map("crm_sales_orders")
}

model EmailConversation {
  id             String         @id @default(ulid()) @map("id")
  email          String         @map("email")
  subject        String?        @map("subject")
  status         String         @default("OPEN") @map("status")
  priority       String         @default("NORMAL") @map("priority")
  sentiment      String?        @map("sentiment")
  tags           Json?          @map("tags")
  lastMessageAt  DateTime?      @map("last_message_at")
  customerId     String?        @map("customer_id")
  agentStatus    String         @default("IDLE") @map("agent_status")
  agentError     String?        @map("agent_error")
  lastOutboundAt DateTime?      @map("last_outbound_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  salesOrders    SalesOrder[]
  customer       Customer?      @relation(fields: [customerId], references: [id])
  messages       EmailMessage[]

  @@index([email])
  @@index([customerId])
  @@index([status])
  @@index([lastMessageAt])
  @@map("email_conversations")
}

model EmailMessage {
  id             String            @id @default(ulid()) @map("id")
  conversationId String            @map("conversation_id")
  direction      String            @map("direction")
  body           String            @map("body")
  htmlBody       String?           @map("html_body")
  messageId      String?           @unique @map("message_id")
  inReplyTo      String?           @map("in_reply_to")
  references     String?           @map("email_references")
  sendStatus     String?           @map("send_status")
  sentAt         DateTime?         @map("sent_at")
  error          String?           @map("error")
  createdAt      DateTime          @default(now()) @map("created_at")
  conversation   EmailConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("email_messages")
}

model SalesOrderItem {
  id              String     @id @default(ulid()) @map("id")
  sortOrder       Int?       @default(0) @map("sort_order")
  salesOrderId    String     @map("sales_order_id")
  skuId           String     @map("sku_id")
  quantity        Decimal    @map("quantity")
  unitPrice       Decimal    @map("unit_price")
  discountPercent Decimal?   @default(0) @map("discount_percent")
  taxPercent      Decimal?   @default(0) @map("tax_percent")
  lineTotal       Decimal    @map("line_total")
  notes           String?    @map("notes")
  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  sku             Sku        @relation(fields: [skuId], references: [id])

  @@index([salesOrderId])
  @@index([skuId])
  @@map("crm_sales_order_items")
}

model Payment {
  id           String     @id @default(ulid()) @map("id")
  salesOrderId String     @map("sales_order_id")
  customerId   String     @map("customer_id")
  date         DateTime   @default(now()) @map("date") @db.Date
  amount       Decimal    @map("amount")
  method       String?    @map("method")
  reference    String?    @map("reference")
  notes        String?    @map("notes")
  createdAt    DateTime   @default(now()) @map("created_at")
  customer     Customer   @relation(fields: [customerId], references: [id])
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@index([customerId])
  @@map("crm_payments")
}

model BudgetType {
  id          String       @id @default(ulid()) @map("id")
  code        String       @unique @map("code")
  name        String       @map("name")
  description String?      @map("description")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  budgetLines BudgetLine[]

  @@map("budget_types")
}

model BudgetPeriod {
  id          String       @id @default(ulid()) @map("id")
  code        String       @unique @map("code")
  name        String       @map("name")
  startDate   DateTime     @map("start_date") @db.Date
  endDate     DateTime     @map("end_date") @db.Date
  status      String       @default("OPEN") @map("status")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  budgetLines BudgetLine[]

  @@map("budget_periods")
}

model BudgetLine {
  id             String          @id @default(ulid()) @map("id")
  budgetTypeId   String          @map("budget_type_id")
  periodId       String          @map("period_id")
  scope          String          @default("AREA") @map("scope")
  regionId       String?         @map("region_id")
  areaId         String?         @map("area_id")
  amount         Decimal         @map("amount")
  currency       String          @default("IDR") @map("currency")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  area           Area?           @relation(fields: [areaId], references: [id])
  budgetType     BudgetType      @relation(fields: [budgetTypeId], references: [id])
  period         BudgetPeriod    @relation(fields: [periodId], references: [id])
  region         Region?         @relation(fields: [regionId], references: [id])
  actionPrograms ActionProgram[]
  eventProposals EventProposal[]

  @@unique([budgetTypeId, periodId, scope, regionId, areaId])
  @@index([regionId])
  @@index([areaId])
  @@map("budget_lines")
}

model ActionType {
  id             String          @id @default(ulid()) @map("id")
  code           String          @unique @map("code")
  name           String          @map("name")
  description    String?         @map("description")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  actionPrograms ActionProgram[]

  @@map("action_types")
}

model EventType {
  id             String          @id @default(ulid()) @map("id")
  code           String          @unique @map("code")
  name           String          @map("name")
  description    String?         @map("description")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  eventProposals EventProposal[]

  @@map("event_types")
}

model Vendor {
  id           String        @id @default(ulid()) @map("id")
  code         String?       @unique @map("code")
  name         String        @map("name")
  contactName  String?       @map("contact_name")
  contactPhone String?       @map("contact_phone")
  email        String?       @map("email")
  address      String?       @map("address")
  category     String?       @map("category")
  status       String        @default("ACTIVE") @map("status")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  eventVendors EventVendor[]

  @@map("vendors")
}

model EventMiscItem {
  id              String        @id @default(ulid()) @map("id")
  eventProposalId String        @map("event_proposal_id")
  name            String        @map("name")
  category        String?       @map("category")
  quantity        Decimal       @map("quantity")
  price           Decimal       @map("price")
  total           Decimal       @map("total")
  notes           String?       @map("notes")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  eventProposal   EventProposal @relation(fields: [eventProposalId], references: [id], onDelete: Cascade)

  @@index([eventProposalId])
  @@map("event_misc_items")
}

model EventVendor {
  id              String               @id @default(ulid()) @map("id")
  eventProposalId String               @map("event_proposal_id")
  vendorId        String               @map("vendor_id")
  scope           String?              @map("scope")
  amount          Decimal              @map("amount")
  notes           String?              @map("notes")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  payments        EventVendorPayment[]
  eventProposal   EventProposal        @relation(fields: [eventProposalId], references: [id], onDelete: Cascade)
  vendor          Vendor               @relation(fields: [vendorId], references: [id])

  @@index([eventProposalId])
  @@index([vendorId])
  @@map("event_vendors")
}

model EventVendorPayment {
  id            String      @id @default(ulid()) @map("id")
  eventVendorId String      @map("event_vendor_id")
  amount        Decimal     @map("amount")
  paymentDate   DateTime    @map("payment_date") @db.Date
  method        String?     @map("method")
  reference     String?     @map("reference")
  notes         String?     @map("notes")
  createdAt     DateTime    @default(now()) @map("created_at")
  eventVendor   EventVendor @relation(fields: [eventVendorId], references: [id], onDelete: Cascade)

  @@index([eventVendorId])
  @@map("event_vendor_payments")
}

model ActionProgram {
  id                         String                 @id @default(ulid()) @map("id")
  documentNumber             String?                @unique @map("document_number")
  name                       String                 @map("name")
  description                String?                @map("description")
  files                      Json?                  @map("files")
  startDate                  DateTime               @map("start_date") @db.Date
  endDate                    DateTime               @map("end_date") @db.Date
  budgetCurrency             String                 @default("IDR") @map("budget_currency")
  rules                      Json                   @map("rules")
  areaId                     String                 @map("area_id")
  picId                      String                 @map("pic_id")
  approvalStatus             ApprovalStatus         @default(DRAFT) @map("approval_status")
  createdById                String                 @map("created_by_id")
  areaManagerApprovedById    String?                @map("area_manager_approved_by_id")
  areaManagerApprovedAt      DateTime?              @map("area_manager_approved_at")
  regionManagerApprovedById  String?                @map("region_manager_approved_by_id")
  regionManagerApprovedAt    DateTime?              @map("region_manager_approved_at")
  financeManagerApprovedById String?                @map("finance_manager_approved_by_id")
  financeManagerApprovedAt   DateTime?              @map("finance_manager_approved_at")
  directorApprovedById       String?                @map("director_approved_by_id")
  directorApprovedAt         DateTime?              @map("director_approved_at")
  approvalHistory            Json?                  @map("approval_history")
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")
  actionTypeId               String                 @map("action_type_id")
  budgetLineId               String?                @map("budget_line_id")
  plannedCost                Decimal                @default(0) @map("planned_cost")
  items                      ActionProgramItem[]
  outlets                    ActionProgramOutlet[]
  payments                   ActionProgramPayment[]
  skus                       ActionProgramSku[]
  actionType                 ActionType             @relation(fields: [actionTypeId], references: [id])
  area                       Area                   @relation(fields: [areaId], references: [id])
  budgetLine                 BudgetLine?            @relation(fields: [budgetLineId], references: [id])
  createdBy                  User                   @relation("ap_created_by", fields: [createdById], references: [id], onDelete: Cascade)
  pic                        User                   @relation("action_program_pic", fields: [picId], references: [id], onDelete: Cascade)
  salesOrders                SalesOrder[]

  @@index([areaId])
  @@index([picId])
  @@index([createdById])
  @@index([approvalStatus])
  @@index([startDate, endDate])
  @@index([actionTypeId])
  @@index([budgetLineId])
  @@map("crm_action_programs")
}

model ActionProgramOutlet {
  actionProgramId String        @map("action_program_id")
  outletId        String        @map("outlet_id")
  cost            Decimal       @default(0) @map("cost")
  explanation     String?       @map("explanation")
  actionProgram   ActionProgram @relation(fields: [actionProgramId], references: [id], onDelete: Cascade)
  outlet          Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@id([actionProgramId, outletId])
  @@map("crm_action_program_outlets")
}

model ActionProgramSku {
  actionProgramId    String        @map("action_program_id")
  skuId              String        @map("sku_id")
  quantity           Decimal       @map("quantity")
  price              Decimal       @map("price")
  discount           Decimal       @default(0) @map("discount")
  priceAfterDiscount Decimal       @map("price_after_discount")
  cost               Decimal       @map("cost")
  tax                Decimal       @default(0) @map("tax")
  total              Decimal       @map("total")
  notes              String?       @map("notes")
  actionProgram      ActionProgram @relation(fields: [actionProgramId], references: [id], onDelete: Cascade)
  sku                Sku           @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@id([actionProgramId, skuId])
  @@map("crm_action_program_skus")
}

model ActionProgramPayment {
  id              String        @id @default(ulid()) @map("id")
  actionProgramId String        @map("action_program_id")
  amount          Decimal       @map("amount")
  paymentDate     DateTime      @map("payment_date") @db.Date
  method          String?       @map("method")
  reference       String?       @map("reference")
  notes           String?       @map("notes")
  createdAt       DateTime      @default(now()) @map("created_at")
  actionProgram   ActionProgram @relation(fields: [actionProgramId], references: [id], onDelete: Cascade)

  @@index([actionProgramId])
  @@map("crm_action_program_payments")
}

model ActionProgramItem {
  id              String        @id @default(ulid()) @map("id")
  actionProgramId String        @map("action_program_id")
  name            String        @map("name")
  quantity        Decimal       @map("quantity")
  price           Decimal       @map("price")
  cost            Decimal       @map("cost")
  notes           String?       @map("notes")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  actionProgram   ActionProgram @relation(fields: [actionProgramId], references: [id], onDelete: Cascade)

  @@index([actionProgramId])
  @@map("crm_action_program_items")
}

model EventProposal {
  id                         String                 @id @default(ulid()) @map("id")
  documentNumber             String?                @unique @map("document_number")
  name                       String                 @map("name")
  description                String?                @map("description")
  files                      Json?                  @map("files")
  venue                      String?                @map("venue")
  eventDate                  DateTime               @map("event_date") @db.Date
  eventEndDate               DateTime?              @map("event_end_date") @db.Date
  organizerName              String?                @map("organizer_name")
  organizerContact           String?                @map("organizer_contact")
  areaId                     String                 @map("area_id")
  observationDays            Int                    @default(90) @map("observation_days")
  currency                   String                 @default("IDR") @map("currency")
  approvalStatus             ApprovalStatus         @default(DRAFT) @map("approval_status")
  createdById                String                 @map("created_by_id")
  areaManagerApprovedById    String?                @map("area_manager_approved_by_id")
  areaManagerApprovedAt      DateTime?              @map("area_manager_approved_at")
  regionManagerApprovedById  String?                @map("region_manager_approved_by_id")
  regionManagerApprovedAt    DateTime?              @map("region_manager_approved_at")
  financeManagerApprovedById String?                @map("finance_manager_approved_by_id")
  financeManagerApprovedAt   DateTime?              @map("finance_manager_approved_at")
  directorApprovedById       String?                @map("director_approved_by_id")
  directorApprovedAt         DateTime?              @map("director_approved_at")
  approvalHistory            Json?                  @map("approval_history")
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")
  budgetLineId               String?                @map("budget_line_id")
  eventTypeId                String?                @map("event_type_id")
  plannedCost                Decimal                @default(0) @map("planned_cost")
  payments                   EventProposalPayment[]
  skus                       EventProposalSku[]
  area                       Area                   @relation(fields: [areaId], references: [id])
  budgetLine                 BudgetLine?            @relation(fields: [budgetLineId], references: [id])
  createdBy                  User                   @relation("ep_created_by", fields: [createdById], references: [id], onDelete: Cascade)
  eventType                  EventType?             @relation(fields: [eventTypeId], references: [id])
  miscItems                  EventMiscItem[]
  vendors                    EventVendor[]

  @@index([areaId])
  @@index([createdById])
  @@index([approvalStatus])
  @@index([eventDate])
  @@index([eventTypeId])
  @@index([budgetLineId])
  @@map("crm_event_proposals")
}

model EventProposalSku {
  eventProposalId String        @map("event_proposal_id")
  skuId           String        @map("sku_id")
  quantity        Decimal       @map("quantity")
  price           Decimal       @map("price")
  tax             Decimal       @default(0) @map("tax")
  total           Decimal       @map("total")
  notes           String?       @map("notes")
  eventProposal   EventProposal @relation(fields: [eventProposalId], references: [id], onDelete: Cascade)
  sku             Sku           @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@id([eventProposalId, skuId])
  @@map("crm_event_proposal_skus")
}

model EventProposalPayment {
  id              String        @id @default(ulid()) @map("id")
  eventProposalId String        @map("event_proposal_id")
  amount          Decimal       @map("amount")
  paymentDate     DateTime      @map("payment_date") @db.Date
  method          String?       @map("method")
  reference       String?       @map("reference")
  notes           String?       @map("notes")
  createdAt       DateTime      @default(now()) @map("created_at")
  eventProposal   EventProposal @relation(fields: [eventProposalId], references: [id], onDelete: Cascade)

  @@index([eventProposalId])
  @@map("crm_event_proposal_payments")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model KnowledgeChunk {
  id                 String                 @id @default(ulid()) @map("id")
  source             String                 @map("source")
  title              String                 @map("title")
  content            String                 @map("content")
  /// Hybrid RAG vector (pgvector). Written via raw SQL when EMBEDDING_* is configured.
  /// Prisma Unsupported — use ai-embedding upsertChunkEmbedding for writes.
  embedding          Unsupported("vector")? @map("embedding")
  embeddingModel     String?                @map("embedding_model")
  embeddingUpdatedAt DateTime?              @map("embedding_updated_at")
  embeddingStatus    String                 @default("none") @map("embedding_status")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  @@index([source])
  @@map("knowledge_chunks")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model UserSetting {
  userId    String   @map("user_id")
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([userId, key])
  @@map("user_settings")
}

enum ApprovalStatus {
  DRAFT
  VALIDATING
  PROPOSED
  APPROVED
  REJECTED
}

enum AiValidationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationTargetType {
  SYSTEM
  SALES_ORDER
  PAYMENT
  ACTION_PROGRAM
  EVENT_PROPOSAL
  VISIT_LOG
  CUSTOMER
  OUTLET
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// Operational log (server + client-reported events) surfaced in the
// in-app system-logs viewer. No FK on userId so logs survive user deletion.
model AppLog {
  id        String   @id @default(ulid()) @map("id")
  level     LogLevel @default(INFO) @map("level")
  module    String   @map("module")
  message   String   @map("message")
  detail    Json?    @map("detail")
  requestId String?  @map("request_id")
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([module, createdAt])
  @@map("app_logs")
}

// Revoked JWT ids (logout). Purged once expired by lib/token-blacklist.ts.
model RevokedToken {
  jti       String   @id @map("jti")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("revoked_tokens")
}

enum SettingScope {
  APP
  USER
}

enum BackupSource {
  CREATED
  UPLOADED
}

model Setting {
  id        String      @id @default(cuid())
  key       String      @map("key")
  value     Json        @map("value")
  scope     SettingScope @map("scope")
  userId    String?     @map("user_id")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@unique([key, userId])
  @@index([scope])
  @@index([userId])
  @@map("settings")
}

// Backup metadata. The backup file itself lives on disk, never in the DB.
model Backup {
  id            String       @id @default(ulid()) @map("id")
  filename      String       @unique @map("filename")
  sizeBytes     Int          @map("size_bytes")
  tableCounts   Json         @map("table_counts")
  schemaVersion String       @map("schema_version")
  source        BackupSource @map("source")
  note          String?      @map("note")
  createdById   String       @map("created_by_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  createdBy     User         @relation("backup_created_by", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@map("backups")
}

// AI Admin chat SQL gate. The server executes exactly sqlText once, only when
// status is "confirmed" (one-time-use); state transitions are enforced in
// application code (aiChat router), not DB constraints.
model AiActionConfirmation {
  id        String   @id @default(ulid()) @map("id")
  widgetId  String   @map("widget_id")
  sqlText   String   @map("sql_text")
  readOnly  Boolean  @map("read_only")
  backupAck Boolean  @default(false) @map("backup_ack")
  status    String   @default("pending") @map("status")
  chatId    String   @map("chat_id")
  createdBy String   @map("created_by")
  result    Json?    @map("result")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([chatId])
  @@index([createdBy])
  @@map("ai_action_confirmations")
}
