# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://user:password@localhost:5432/erp_warehouse?schema=public"

# JWT signing secret — MUST be changed in production
JWT_SECRET="your-secret-key-change-this"

# ─── Optional (defaults shown) ───────────────────────────────────────────────

# HTTP port for the Express server
PORT=10022

# Allowed CORS origins in production (comma-separated if multiple).
# In development, all localhost:* ports and tauri://localhost are allowed automatically.
# CORS_ORIGIN="https://erp-sales.aetherglo.com,https://erp-sales-api.aetherglo.com"

# PostgreSQL connection pool settings
DB_POOL_MAX=10
DB_POOL_IDLE_MS=10000
DB_POOL_CONNECT_TIMEOUT_MS=2000

# Set to "production" to enable strict CORS and secure cookie flag.
# Also enables Express static serving of the built client (apps/client/dist).
# NODE_ENV="production"

# OpenAI-compatible chat provider (e.g. Upstage: https://api.upstage.ai/v1 + solar-pro4)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Embeddings for hybrid RAG. Falls back to AI_BASE_URL / AI_MODEL / AI_API_KEY
# when the embedding-specific vars are unset. Example (Upstage Solar):
#   AI_EMBEDDING_BASE_URL=https://api.upstage.ai/v1
#   AI_EMBEDDING_MODEL=solar-embedding-2-query
#   AI_EMBEDDING_DIMENSIONS=1024   # native Solar dim; must match knowledge_chunks.embedding
# OpenAI text-embedding-3-small uses 1536. Must match the model's native size.
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=1024

# AI rate limit (requests per minute, rolling 60s window) for the shared API
# key. Configurable in Settings → AI provider (stored in DB; this env is a
# fallback). Unset = unlimited — requests beyond the limit WAIT IN A QUEUE
# instead of failing (max wait below).
# AI_GLOBAL_RPM=40
# Max time an AI request may wait in the queue before returning 429.
# Keep below the 30s request timeout.
AI_QUEUE_MAX_WAIT_MS=25000


# Dedicated AI system user for audit trails (email CRM draft orders, customer AI tools).
# Seed creates this user automatically (ai-system@mail.com / System Admin role).
# Only set this if you need a different email than the default.
# AI_SYSTEM_EMAIL=ai-system@mail.com

# Max chars for the untrusted email thread fed to the email concierge model.
# Keeps the prompt under the model context window for long conversations.
# EMAIL_CONCIERGE_MAX_THREAD_CHARS=12000

# Shared secret for Cloudflare Email Worker → POST /api/email/inbound
EMAIL_WEBHOOK_SECRET=

# Outbound SMTP (Email CRM). Values configured in Settings (DB appSetting) are
# authoritative; these env vars are bootstrap defaults only. Works with ANY
# provider — no Brevo assumption. SMTP_SECURE: none | starttls | ssl (unset =
# infer from the port: 465 → ssl, otherwise starttls). Never commit SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AetherGlo Sales <info@aetherglo.com>

# Demo login (local dev/demo ONLY) — enables public auth.listDemoUsers +
# auth.demoLogin (no credentials, public by design). Never enable in
# production with real data.
DEMO_LOGIN_ENABLED=true