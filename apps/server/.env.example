# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://user:password@localhost:5432/erp_warehouse?schema=public"

# JWT signing secret — MUST be changed in production
JWT_SECRET="your-secret-key-change-this"

# ─── Optional (defaults shown) ───────────────────────────────────────────────

# HTTP port for the Express server
PORT=10022

# Allowed CORS origins in production (comma-separated if multiple).
# In development, all localhost:* ports and tauri://localhost are allowed automatically.
# CORS_ORIGIN="https://erp-sales.aetherglo.com,https://erp-sales-api.aetherglo.com"

# PostgreSQL connection pool settings
DB_POOL_MAX=1
DB_POOL_IDLE_MS=10000
DB_POOL_CONNECT_TIMEOUT_MS=2000

# Set to "production" to enable strict CORS and secure cookie flag.
# Also enables Express static serving of the built client (apps/client/dist).
# NODE_ENV="production"

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=


# Dedicated AI system user for audit trails (email CRM draft orders, customer AI tools).
# Seed creates this user automatically (ai-system@mail.com / System Admin role).
# Only set this if you need a different email than the default.
# AI_SYSTEM_EMAIL=ai-system@mail.com

# Max chars for the untrusted email thread fed to the email concierge model.
# Keeps the prompt under the model context window for long conversations.
# EMAIL_CONCIERGE_MAX_THREAD_CHARS=12000

# Shared secret for Cloudflare Email Worker → POST /api/email/inbound
EMAIL_WEBHOOK_SECRET=

# Brevo SMTP (outbound Email CRM) — never commit real SMTP_PASS
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AetherGlo Sales <info@aetherglo.com>