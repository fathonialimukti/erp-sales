{
  "name": "erp-sales-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun prisma generate && tsc -p tsconfig.json && rm -rf dist/prisma/generated && cp -r src/prisma/generated dist/prisma/generated && rm -rf dist/knowledge && cp -r src/knowledge dist/knowledge",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "db:all": "bun prisma generate && bun prisma db push --force-reset && bun prisma db seed && bun src/scripts/ingest-knowledge.ts",
    "seed:ph": "bun src/prisma/seed/index.ts",
    "ai:ingest": "bun src/scripts/ingest-knowledge.ts",
    "ai:devtools": "bunx @ai-sdk/devtools"
  },
  "dependencies": {
    "@ai-sdk/devtools": "^1.0.9",
    "@ai-sdk/openai": "^4.0.24",
    "@ai-sdk/openai-compatible": "^3.0.17",
    "@faker-js/faker": "^10.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "^7.9.1",
    "@repo/schemas": "*",
    "@trpc/server": "^11.18.0",
    "ai": "^7.0.42",
    "bcrypt": "^6.0.0",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "install": "^0.13.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
